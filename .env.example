# Copiar este archivo a .env y completar los valores reales (.env nunca se versiona)

# PostgreSQL: usar DATABASE_URL, o dejarla vacia y completar las variables PG_*
DATABASE_URL=

PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=zni_energia
PG_USER=postgres
PG_PASSWORD=

# Token de la API de datos.gov.co (opcional; aumenta el limite de tasa de Socrata)
SOCRATA_APP_TOKEN=
