# Entorno y credenciales
.env
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Datos: se ignoran los contenidos, se conservan los directorios via .gitkeep
data/bronze/*
!data/bronze/.gitkeep
data/silver/*
!data/silver/.gitkeep
data/gold/*
!data/gold/.gitkeep

# Logs: se ignoran los contenidos, se conserva el directorio via .gitkeep
logs/*
!logs/.gitkeep
